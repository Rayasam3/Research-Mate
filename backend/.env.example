# -- App ----------------------------------------------------------------
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated list of allowed origins for CORS.
# In production this MUST be your real frontend domain, not "*".
# For local dev, keep as-is. For production deployment, set this to your
# real Vercel frontend URL (e.g. https://research-mate.vercel.app) in
# Render's environment variables dashboard - never commit a real
# production URL here, since .env.example is just a template.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# -- Rate limiting (public-service guardrail, enforced from Phase 0) ----
RATE_LIMIT_SEARCH=30/hour
RATE_LIMIT_DEFAULT=100/hour

# -- Paper search sources (Phase 1) --------------------------------------
# Semantic Scholar works without a key at low volume, but a free API key
# raises your rate limit substantially. Get one at:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# PubMed / NCBI E-utilities. An email is required by NCBI's usage policy;
# an API key is optional but raises your rate limit (3/sec -> 10/sec).
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=

# Max results pulled per source per search, before merge/dedupe
SEARCH_MAX_RESULTS_PER_SOURCE=10
SEARCH_CACHE_TTL_SECONDS=3600

# -- Phase 2: ingestion ---------------------------------------------------
PAPERS_DIR=data/papers
CACHE_DIR=data/cache
CHROMA_PERSIST_DIR=data/cache/chroma
EMBEDDING_MODEL=all-MiniLM-L6-v2
CHUNK_SIZE_CHARS=1500
CHUNK_OVERLAP_CHARS=200
PDF_DOWNLOAD_TIMEOUT_SECONDS=30

# -- Phase 3: LLM summary generation --------------------------------------
# llm_provider selects the backend: "ollama" (free, local, slow on
# CPU-only machines) or "groq" (hosted, much faster, needs a free key).
LLM_PROVIDER=groq

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=600

# Free key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=60


# -- Phase 5: knowledge graph ----------------------------------------------
# Neo4j AuraDB (cloud): use the neo4j+s:// address shown in the Aura console.
# The Aura "instance id" is both the user and the database name on free instances.
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_DATABASE=neo4j

# Full-paper reading: how much text the LLM sees, and the pause between Groq calls
# (the free Groq tier allows about 8,000 tokens per minute).
RECORD_WINDOW_CHARS=4000
RECORD_MAX_CALLS_PER_PASS=2
RECORD_CALL_GAP_SECONDS=15

# Papers less similar to the topic than this (0 to 1) are dropped.
RELEVANCE_MIN_SIMILARITY=0.2

# -- Login (PostgreSQL) -----------------------------------------------------
DATABASE_URL=postgresql+asyncpg://rm_admin:RmSecurePass2026@localhost:5434/research_mate_users
JWT_SECRET_KEY=change-this-to-a-long-random-string

# -- Phase 8: Redis caching --------------------------------------------------
# Using port 6380 on the host to avoid colliding with other local
# projects that may already use Redis's default port 6379.
REDIS_URL=redis://localhost:6380/0
USE_REDIS_CACHE=true

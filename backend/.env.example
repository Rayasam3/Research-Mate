# ── App ────────────────────────────────────────────────────────────────
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Comma-separated list of allowed origins for CORS.
# In production this MUST be your real frontend domain, not "*".
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Rate limiting (public-service guardrail, enforced from Phase 0) ────
# Format understood by slowapi, e.g. "30/hour", "10/minute"
RATE_LIMIT_SEARCH=30/hour
RATE_LIMIT_DEFAULT=100/hour

# ── Paper search sources (Phase 1) ──────────────────────────────────────
# Semantic Scholar works without a key at low volume, but a free API key
# raises your rate limit substantially. Get one at:
# https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# PubMed / NCBI E-utilities. An email is required by NCBI's usage policy;
# an API key is optional but raises your rate limit (3/sec -> 10/sec).
# https://www.ncbi.nlm.nih.gov/account/settings/
PUBMED_EMAIL=your-email@example.com
PUBMED_API_KEY=

# Max results pulled per source per search, before merge/dedupe
SEARCH_MAX_RESULTS_PER_SOURCE=10

# ── Future phases (placeholders, not used until Phase 2+) ──────────────
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
# REDIS_URL=redis://localhost:6379/0
# CHROMA_PERSIST_DIR=./data/cache/chroma
